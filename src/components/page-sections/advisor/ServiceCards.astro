---
import servicesData from "@data/services.json";

interface Props {
  heading?: string;
}

const { heading = "How We Help" } = Astro.props;
const { services } = servicesData;
---

<section class="py-20 md:py-28" style="background:#FAF8F5;">
  <div class="max-w-7xl mx-auto px-6">
    <h2
      class="text-3xl md:text-4xl text-center mb-14"
      style="font-family:var(--font-family-serif,'DM Serif Display',Georgia,serif); color:var(--color-primary,#1B2B4B);"
    >
      {heading}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        services.map((service) => (
          <div
            id={service.id}
            class="rounded-2xl p-8 flex flex-col hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
            style="background:#fff; border:1px solid #E5E7EB;"
          >
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center mb-6"
              style="background:color-mix(in srgb, var(--color-accent,#C9A96E) 15%, transparent);"
            >
              <svg
                class="w-6 h-6"
                style="color:var(--color-accent,#C9A96E);"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.5"
              >
                {service.icon === "chart-bar" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"
                  />
                )}
                {service.icon === "trending-up" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"
                  />
                )}
                {service.icon === "document-text" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
                  />
                )}
                {service.icon === "shield-check" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
                  />
                )}
                {service.icon === "umbrella" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
                  />
                )}
                {!["chart-bar", "trending-up", "document-text", "shield-check", "umbrella"].includes(
                  service.icon
                ) && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                )}
              </svg>
            </div>
            <h3
              class="text-xl font-semibold mb-3"
              style="color:var(--color-primary,#1B2B4B);"
            >
              {service.title}
            </h3>
            <p
              class="leading-relaxed mb-6 flex-1"
              style="color:var(--color-text-muted,#4B5563);"
            >
              {service.description}
            </p>
            <a
              href={service.ctaUrl}
              class="inline-flex items-center text-sm font-semibold border rounded-full px-5 py-2 mt-auto transition-colors hover:opacity-80"
              style="color:var(--color-primary,#1B2B4B); border-color:var(--color-primary,#1B2B4B);"
            >
              {service.ctaLabel}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
