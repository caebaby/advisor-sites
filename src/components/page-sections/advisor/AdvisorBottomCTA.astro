---
import siteData from "@data/site.json";

interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaUrl?: string;
}

const {
  heading = siteData.bottomCtaHeading,
  body = siteData.bottomCtaBody,
  ctaLabel = siteData.bottomCtaLabel,
  ctaUrl = siteData.bottomCtaUrl,
} = Astro.props;
---

<section class="py-20 md:py-28" style="background:var(--color-primary,#1B2B4B);">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <h2
      class="text-3xl md:text-4xl mb-6"
      style="font-family:var(--font-family-serif,'DM Serif Display',Georgia,serif); color:#fff;"
    >
      {heading}
    </h2>
    <p class="text-lg leading-relaxed mb-10" style="color:rgba(255,255,255,0.75);">
      {body}
    </p>
    <a
      href={ctaUrl}
      class="inline-flex items-center justify-center px-10 py-4 rounded-full font-semibold text-sm tracking-wide transition-all duration-200 hover:scale-105"
      style="background:var(--color-accent,#C9A96E); color:var(--color-primary,#1B2B4B);"
    >
      {ctaLabel}
    </a>
  </div>
</section>
