---
const {
  headline = "Your Financial Life, Finally Under Control",
  subheadline = "Independent, fee-only financial planning for physicians, executives, and business owners.",
  ctaLabel = "Schedule a Free Consultation",
  ctaUrl = "https://calendly.com/placeholder",
  secondaryLabel = "See How We Help →",
  secondaryUrl = "/services/",
  heroImage = "https://images.unsplash.com/photo-1560520653-9e0e4c89eb11?w=1200&q=80",
  heroImageAlt = "Financial advisor in a modern office",
} = Astro.props;
---

<section class="advisor-hero-section">
  <div style="max-width:80rem; margin:0 auto; padding:0 1.5rem;">
    <div class="advisor-hero-grid">
      <!-- Text column -->
      <div>
        <h1 style="font-family:'DM Serif Display',Georgia,serif; color:#1B2B4B; font-size:clamp(2.5rem,5vw,4rem); line-height:1.15; margin-bottom:1.5rem; font-weight:400;">
          {headline}
        </h1>
        <p style="font-size:1.125rem; line-height:1.75; color:#4B5563; margin-bottom:2.5rem; max-width:30rem;">
          {subheadline}
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:1rem; align-items:center;">
          <a href={ctaUrl} class="advisor-cta-primary">{ctaLabel}</a>
          <a href={secondaryUrl} class="advisor-cta-ghost">{secondaryLabel}</a>
        </div>
      </div>
      <!-- Image column -->
      <div style="position:relative;">
        <div class="advisor-hero-img-wrap">
          <img src={heroImage} alt={heroImageAlt} loading="eager" />
        </div>
        <div style="position:absolute; bottom:-1rem; right:-1rem; width:6rem; height:6rem; border-radius:1rem; background:rgba(201,169,110,0.2); z-index:-1;"></div>
        <div style="position:absolute; top:-1rem; left:-1rem; width:4rem; height:4rem; border-radius:0.75rem; background:rgba(27,43,75,0.08); z-index:-1;"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .advisor-hero-section {
    padding: 5rem 0;
    background: #FAF8F5;
  }
  @media (min-width: 768px) {
    .advisor-hero-section { padding: 7rem 0; }
  }
  .advisor-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .advisor-hero-grid { grid-template-columns: 1fr 1fr; }
  }
  .advisor-hero-img-wrap {
    aspect-ratio: 4/5;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
  }
  .advisor-hero-img-wrap img { width:100%; height:100%; object-fit:cover; }
  .advisor-cta-primary {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 1rem 2rem; border-radius: 9999px; font-weight: 600;
    font-size: 0.875rem; letter-spacing: 0.025em;
    background: #C9A96E; color: #1B2B4B; text-decoration: none;
    transition: transform 0.2s;
  }
  .advisor-cta-primary:hover { transform: scale(1.05); }
  .advisor-cta-ghost {
    display: inline-flex; align-items: center; padding: 1rem 2rem;
    border-radius: 9999px; font-weight: 600; font-size: 0.875rem;
    color: #C9A96E; text-decoration: none;
  }
  .advisor-cta-ghost:hover { text-decoration: underline; }
</style>
