---
interface Props {
  heading?: string;
  body?: string;
  photo?: string;
  photoAlt?: string;
}

const {
  heading = "Why I Became an Independent Advisor",
  body = "After 12 years at a major wirehouse, I founded Harmon Wealth Advisors as a fee-only RIA — no commissions, no product sales, no conflicts of interest. Just a fiduciary relationship with every client I serve.",
  photo = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&q=80",
  photoAlt = "James R. Harmon, CFP®",
} = Astro.props;

// Split on \n\n for paragraphs
const paragraphs = body.split("\n\n").filter(Boolean);
---

<section class="py-20 md:py-28" style="background:#FAF8F5;">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Photo -->
      <div class="relative">
        <div class="rounded-3xl overflow-hidden shadow-2xl aspect-[3/4]">
          <img
            src={photo}
            alt={photoAlt}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <!-- Decorative gold shape -->
        <div
          class="absolute -bottom-6 -left-6 w-32 h-32 rounded-2xl -z-10"
          style="background:color-mix(in srgb, var(--color-accent,#C9A96E) 25%, transparent);"
        ></div>
      </div>

      <!-- Story -->
      <div class="lg:pt-8">
        <h2
          class="text-3xl md:text-4xl mb-8"
          style="font-family:var(--font-family-serif,'DM Serif Display',Georgia,serif); color:var(--color-primary,#1B2B4B);"
        >
          {heading}
        </h2>
        <div class="space-y-5">
          {
            paragraphs.map((para) => (
              <p class="text-lg leading-relaxed" style="color:var(--color-text-muted,#4B5563);">
                {para}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
