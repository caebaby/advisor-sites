---
import testimonialsData from "@data/testimonials.json";

interface Props {
  heading?: string;
  complianceNote?: string;
}

const {
  heading = "What Clients Say",
  complianceNote = "Client testimonials may not be representative of all clients' experiences. Past performance is not indicative of future results.",
} = Astro.props;

const { testimonials } = testimonialsData;
---

<section class="py-20 md:py-28" style="background:#FAF8F5;">
  <div class="max-w-7xl mx-auto px-6">
    <h2
      class="text-3xl md:text-4xl text-center mb-14"
      style="font-family:var(--font-family-serif,'DM Serif Display',Georgia,serif); color:var(--color-primary,#1B2B4B);"
    >
      {heading}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
      {
        testimonials.map((t) => (
          <div
            class="rounded-2xl p-8 hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
            style="background:#fff; border-left:4px solid var(--color-accent,#C9A96E);"
          >
            <blockquote
              class="text-lg italic leading-relaxed mb-6"
              style="color:var(--color-text-muted,#4B5563);"
            >
              "{t.quote}"
            </blockquote>
            <div>
              <div
                class="font-semibold"
                style="color:var(--color-primary,#1B2B4B);"
              >
                {t.name}
              </div>
              <div class="text-sm" style="color:var(--color-text-muted,#4B5563);">
                {t.title} &mdash; {t.location}
              </div>
            </div>
          </div>
        ))
      }
    </div>
    {
      complianceNote && (
        <p class="text-xs text-center max-w-2xl mx-auto" style="color:var(--color-text-muted,#6B7280);">
          {complianceNote}
        </p>
      )
    }
  </div>
</section>
