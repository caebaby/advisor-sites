---
import { getCollection, type CollectionEntry } from "astro:content";
import siteData from "@data/site.json";

export async function getStaticPaths() {
  const pages = await getCollection("landing");
  return pages.map((page: CollectionEntry<"landing">) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

interface Props {
  page: CollectionEntry<"landing">;
}

const { page } = Astro.props;
const { headline, subheadline, heroImage, heroImageAlt, ctaHeading, bullets, ctaLabel, ctaUrl } =
  page.data;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{page.data.title} | Harmon Wealth Advisors</title>
    <meta name="description" content={page.data.subheadline} />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --color-primary: #1b2b4b;
        --color-accent: #c9a96e;
        --color-bg: #faf8f5;
        --font-serif: "DM Serif Display", Georgia, serif;
        --font-body: "Plus Jakarta Sans", system-ui, sans-serif;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: var(--font-body);
        background: #fff;
        color: #374151;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <!-- Minimal header — logo only -->
    <header
      style="background:var(--color-primary); padding:1.25rem 1.5rem; display:flex; align-items:center; justify-content:center;"
    >
      <span
        style="font-family:var(--font-serif); color:#fff; font-size:1.25rem; letter-spacing:0.02em;"
      >
        {siteData.firmName}
      </span>
    </header>

    <!-- Hero -->
    <section style="background:var(--color-bg); padding:4rem 1.5rem;">
      <div style="max-width:900px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:3rem; align-items:center;">
        <div>
          <h1
            style="font-family:var(--font-serif); color:var(--color-primary); font-size:clamp(1.75rem,4vw,2.75rem); line-height:1.2; margin-bottom:1.25rem;"
          >
            {headline}
          </h1>
          <p style="font-size:1.125rem; color:#4B5563; line-height:1.7;">{subheadline}</p>
        </div>
        <div style="border-radius:1.25rem; overflow:hidden; box-shadow:0 20px 40px rgba(0,0,0,0.12);">
          <img
            src={heroImage}
            alt={heroImageAlt}
            style="width:100%; height:300px; object-fit:cover; display:block;"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <!-- Video placeholder -->
    <section style="padding:3rem 1.5rem; background:#fff;">
      <div style="max-width:720px; margin:0 auto;">
        <div
          style="aspect-ratio:16/9; background:var(--color-primary); border-radius:1rem; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;"
        >
          <div
            style="width:72px; height:72px; background:var(--color-accent); border-radius:50%; display:flex; align-items:center; justify-content:center;"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              style="width:32px; height:32px; color:var(--color-primary); margin-left:4px;"
            >
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </div>
          <p
            style="position:absolute; bottom:1.5rem; color:rgba(255,255,255,0.6); font-size:0.875rem;"
          >
            Watch the free training
          </p>
        </div>
      </div>
    </section>

    <!-- CTA section -->
    <section style="background:var(--color-bg); padding:4rem 1.5rem;">
      <div style="max-width:720px; margin:0 auto; text-align:center;">
        <h2
          style="font-family:var(--font-serif); color:var(--color-primary); font-size:clamp(1.5rem,3vw,2.25rem); margin-bottom:2rem;"
        >
          {ctaHeading}
        </h2>
        <ul style="list-style:none; text-align:left; display:inline-block; margin-bottom:2.5rem;">
          {
            bullets.map((b) => (
              <li
                style="display:flex; align-items:flex-start; gap:0.75rem; margin-bottom:1rem; font-size:1.0625rem; color:#374151;"
              >
                <span
                  style="flex-shrink:0; width:22px; height:22px; background:var(--color-accent); border-radius:50%; display:flex; align-items:center; justify-content:center; margin-top:2px;"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    style="width:12px; height:12px; color:var(--color-primary);"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                {b.text}
              </li>
            ))
          }
        </ul>
        <a
          href={ctaUrl}
          style="display:inline-flex; align-items:center; justify-content:center; padding:1rem 2.5rem; border-radius:9999px; font-weight:700; font-size:1rem; background:var(--color-accent); color:var(--color-primary); text-decoration:none; transition:opacity 0.2s;"
        >
          {ctaLabel}
        </a>
      </div>
    </section>

    <!-- Calendar placeholder -->
    <section style="padding:4rem 1.5rem; background:#fff;">
      <div style="max-width:720px; margin:0 auto;">
        <div
          style="height:600px; background:var(--color-bg); border-radius:1rem; border:2px dashed #D1D5DB; display:flex; align-items:center; justify-content:center;"
        >
          <p style="color:#9CA3AF; font-size:0.875rem;">Calendar embed goes here</p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer
      style="background:var(--color-primary); padding:2rem 1.5rem; text-align:center;"
    >
      <p style="color:rgba(255,255,255,0.5); font-size:0.75rem; max-width:640px; margin:0 auto;">
        {siteData.firmName} &bull; {siteData.footerDisclaimer}
      </p>
    </footer>
  </body>
</html>
