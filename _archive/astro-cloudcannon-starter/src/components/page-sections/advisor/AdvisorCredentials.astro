---
interface Certification {
  name: string;
}

interface Props {
  heading?: string;
  certifications?: Certification[];
  yearsExperience?: number;
  aumDisplay?: string;
}

const {
  heading = "Credentials & Experience",
  certifications = [{ name: "CFP®" }, { name: "CPWA®" }],
  yearsExperience = 18,
  aumDisplay = "$320M+ AUM",
} = Astro.props;
---

<section class="py-20 md:py-28" style="background:var(--color-primary,#1B2B4B);">
  <div style="max-width:80rem; margin:0 auto; padding:0 1.5rem; text-align:center;">
    <h2
      class="text-3xl md:text-4xl mb-12"
      style="font-family:var(--font-family-serif,'DM Serif Display',Georgia,serif); color:#fff;"
    >
      {heading}
    </h2>

    <!-- Stats row -->
    <div class="creds-row" style="margin-bottom:3.5rem;">
      <div>
        <div
          class="text-4xl md:text-5xl font-bold mb-2"
          style="color:var(--color-accent,#C9A96E);"
        >
          {yearsExperience}+
        </div>
        <div class="text-sm uppercase tracking-widest" style="color:rgba(255,255,255,0.6);">
          Years Experience
        </div>
      </div>
      <div>
        <div
          class="text-4xl md:text-5xl font-bold mb-2"
          style="color:var(--color-accent,#C9A96E);"
        >
          {aumDisplay}
        </div>
        <div class="text-sm uppercase tracking-widest" style="color:rgba(255,255,255,0.6);">
          Assets Advised
        </div>
      </div>
      <div>
        <div
          class="text-4xl md:text-5xl font-bold mb-2"
          style="color:var(--color-accent,#C9A96E);"
        >
          100%
        </div>
        <div class="text-sm uppercase tracking-widest" style="color:rgba(255,255,255,0.6);">
          Fee-Only Fiduciary
        </div>
      </div>
    </div>

    <!-- Certifications -->
    <div class="creds-row">
      {
        certifications.map((cert) => (
          <span
            class="px-6 py-3 rounded-full text-sm font-semibold border"
            style="color:var(--color-accent,#C9A96E); border-color:color-mix(in srgb, var(--color-accent,#C9A96E) 40%, transparent);"
          >
            {cert.name}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .creds-row { display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:3rem; }
</style>
